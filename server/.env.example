# ---------------------------------------------------------------------------
# SmartQueue API — environment configuration
# Copy to `.env` and edit. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Timezone used for queue_date and service-hour comparisons.
# The server does ALL date arithmetic in this zone (see docs/architecture.md §10).
TZ=Africa/Nairobi

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production / normal development — MySQL 8:
DATABASE_URL=mysql://root:password@localhost:3306/smart_queue
#
# Local sandbox / CI without a MySQL server — file-backed SQLite.
# Identical schema, identical repository layer, selected purely by the URL scheme.
# DATABASE_URL=sqlite://./database/local/smart_queue.db

DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated allow-list. Use * only in development.
CORS_ORIGIN=*

# Requests allowed per IP per window. AUTH guards the credential endpoints,
# JOIN guards queue joins, API is the backstop across everything under /api/v1
# (a polling client uses ~300 of it per window, so 1000 is generous).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_JOIN_MAX=20
RATE_LIMIT_API_MAX=1000

# ---------------------------------------------------------------------------
# Queue engine defaults (used when a service has no queue_settings row)
# ---------------------------------------------------------------------------
QUEUE_DEFAULT_SERVICE_MINUTES=5
QUEUE_NOTIFY_THRESHOLD=3
QUEUE_DEFAULT_MAX_SIZE=100

# Password given to every seeded demo account.
SEED_PASSWORD=Password123!
