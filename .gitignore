mobile/.flutter-plugins-dependencies

# Platform scaffolding is generated by `flutter create .` on the machine that
# runs the app — 126 files of it — and is not part of the source. Ignoring the
# folders wholesale keeps `git status` readable after a first run.
mobile/android/
mobile/ios/
mobile/linux/
mobile/macos/
mobile/windows/
mobile/web/

# `flutter create .` also drops in the counter-app template test, which fails
# immediately because this project has no MyApp. Delete it after a first run;
# this stops it being committed if it comes back.
mobile/test/widget_test.dart

*.iml

# ---------- Editors / OS ----------
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
