# Copy this file to .env and change the values for your local MySQL setup.
PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_queue_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10

# Use a long, random value outside of source control in a real deployment.
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10
